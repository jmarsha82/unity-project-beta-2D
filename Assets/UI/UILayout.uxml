<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="Score: 0" name="ScoreLabel" style="top: 30px; align-content: flex-start; align-self: center; font-size: 20px; color: rgb(243, 161, 22); -unity-text-outline-color: rgb(14, 14, 14); -unity-text-outline-width: 0.5px; -unity-font-style: bold; border-left-color: rgb(248, 181, 11); border-right-color: rgb(248, 181, 11); border-top-color: rgb(248, 181, 11); border-bottom-color: rgb(248, 181, 11); border-top-width: 1px; border-right-width: 2px; border-bottom-width: 1px; border-left-width: 2px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; background-color: rgba(243, 221, 148, 0.361); padding-left: 5px; padding-right: 5px; margin-right: 1px; margin-top: 1px; margin-left: 1px; margin-bottom: 1px; padding-top: 5px; padding-bottom: 5px;"/>
    <ui:Button text="Restart" name="RestartButton" style="align-self: center; position: absolute; top: 50%; font-size: 26px; -unity-font-style: bold; color: rgb(140, 6, 6); border-left-color: rgb(154, 12, 12); border-right-color: rgb(154, 12, 12); border-top-color: rgb(154, 12, 12); border-bottom-color: rgb(154, 12, 12); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; background-color: rgba(241, 187, 187, 0.639);"/>
    <ui:Label text="High Score: 0" name="HighScoreLabel" style="top: 55%; align-self: center; -unity-font-style: bold; font-size: 26px; color: rgb(14, 192, 26); background-color: rgba(160, 231, 170, 0.722); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-left-color: rgb(20, 248, 34); border-right-color: rgb(20, 248, 34); border-top-color: rgb(20, 248, 34); border-bottom-color: rgb(20, 248, 34); padding-left: 10px; margin-left: 1px; margin-right: 1px; margin-top: 1px; margin-bottom: 1px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px;"/>
</ui:UXML>
